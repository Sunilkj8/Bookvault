# ==========================================
# BookVault Frontend Repository .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build artifacts
dist/
dist-ssr/
build/

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite & build tool cache
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.cache/
.eslintcache
.stylelintcache

# Coverage directory used by tools like Istanbul / Jest / Vitest
coverage/

# Editor & IDE files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
