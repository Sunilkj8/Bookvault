# BookVault Backend Environment Variables
PORT=3001
NODE_ENV=production

# Database URL for PostgreSQL (Neon pooled connection with PgBouncer)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct URL for migrations and schema pushing (Neon unpooled connection)
DIRECT_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for authentication tokens
JWT_SECRET="replace_with_a_secure_random_jwt_secret"

