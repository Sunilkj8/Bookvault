# ==========================================
# BookVault Backend Service .gitignore
# ==========================================

# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & Runtime files
*.sqlite
*.sqlite3
*.db
*.db-journal
pids
*.pid
*.seed
*.pid.lock

# Temporary & Cache
.cache/
.temp/
tmp/

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
