# ==========================================
# BookVault Backend Repository .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/

# Environment variables & secrets
.env
.env.*
!.env.example
Backend/.env
Backend/.env.*
!Backend/.env.example
authentication/.env
authentication/.env.*
!authentication/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Database & Runtime files
*.sqlite
*.sqlite3
*.db
*.db-journal
pids
*.pid
*.seed
*.pid.lock

# Cache & Temporary
.cache/
.temp/
tmp/
.eslintcache

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
