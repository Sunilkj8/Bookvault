# ==========================================
# BookVault Workspace Root .gitignore
# ==========================================

# Dependency directories
node_modules/
*/node_modules/
*/*/node_modules/

# Production build outputs
dist/
dist-ssr/
build/
out/
*/dist/
*/*/dist/

# Environment variables & secrets
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example
*/*/.env
*/*/.env.*
!*/*/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data & sqlite
pids
*.pid
*.seed
*.pid.lock
*.sqlite
*.sqlite3
*.db
*.db-journal

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Cache & temporary files
.cache/
.temp/
tmp/
.eslintcache
.stylelintcache
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Editor & IDE files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
